@@ meta
dir: trivia
title: Trivia · Kale's Games
desc: Ten quick questions. Faster answers score more.
page: trivia
game: trivia
scripts: /assets/trivia.js
@@ css
.tq{width:100%;max-width:640px;display:grid;gap:14px;position:relative;min-height:380px;align-content:start}
.tbar{height:8px;background:var(--paper);border-radius:99px;overflow:hidden}
.tbar i{display:block;height:100%;background:var(--forest);width:100%;transition:width .2s linear}
.qcat{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2)}
.qtext{font:800 clamp(22px,3.4vw,32px)/1.15 var(--display);letter-spacing:-.025em}
.opts{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media (max-width:560px){.opts{grid-template-columns:1fr}}
.opts button{border:0;border-radius:16px;padding:16px;font:600 16px/1.3 var(--body);text-align:left;cursor:pointer;background:var(--paper)}
.opts button:nth-child(1){background:var(--sky)}.opts button:nth-child(2){background:var(--peach)}.opts button:nth-child(3){background:var(--moss)}.opts button:nth-child(4){background:var(--lilac)}
.opts button.right{background:#4f8a4a;color:#fff}.opts button.wrong{background:#D12C2C;color:#fff}.opts button.dim{opacity:.45}
.intro{display:grid;gap:12px;justify-items:start}
.big{font:800 64px/1 var(--display);letter-spacing:-.04em}
@@ body
<div class="ghead"><div><h1>Trivia</h1><p>Ten questions, 15 seconds each. Correct answers score 100 plus a speed bonus.</p></div><a class="btn sm ghost" href="/play/">Race friends online →</a></div>
<div class="glay">
  <div class="stage"><div class="tq" id="tq"></div></div>
  <div class="side"><div class="box" id="lb"></div></div>
</div>
@@ js
const Q=10,T=15;let qs,i,score,streak,timer,t0,locked;
const el=document.getElementById('tq');
function shuffle(a){a=a.slice();for(let k=a.length-1;k>0;k--){const j=Math.floor(Math.random()*(k+1));[a[k],a[j]]=[a[j],a[k]]}return a}
function intro(){const b=G.local.get('best:trivia',null);el.innerHTML=`<div class="intro"><span class="qcat">${TRIVIA.length} questions in the bank</span><div class="qtext">Ready?</div><p class="muted">Best: ${b??'–'}</p><button class="btn" id="go">Start</button></div>`;document.getElementById('go').onclick=start}
function start(){qs=shuffle(TRIVIA).slice(0,Q);i=0;score=0;streak=0;ask()}
function ask(){locked=false;const q=qs[i],opts=shuffle(q.slice(2));
  el.innerHTML=`<div class="row" style="justify-content:space-between"><span class="qcat">${G.esc(q[0])} · ${i+1}/${Q}</span><b>${score} pts${streak>1?` · 🔥${streak}`:''}</b></div><div class="tbar"><i id="bar"></i></div><div class="qtext">${G.esc(q[1])}</div>
    <div class="opts">${opts.map(o=>`<button data-o="${G.esc(o)}">${G.esc(o)}</button>`).join('')}</div>`;
  t0=Date.now();clearInterval(timer);timer=setInterval(()=>{const left=T-(Date.now()-t0)/1000;document.getElementById('bar').style.width=Math.max(0,100*left/T)+'%';if(left<=0)answer(null)},100);
  el.querySelectorAll('[data-o]').forEach(b=>b.onclick=()=>answer(b))}
function answer(btn){if(locked)return;locked=true;clearInterval(timer);const q=qs[i],right=btn&&btn.dataset.o===q[2];
  if(right){streak++;score+=100+Math.round(100*Math.max(0,T-(Date.now()-t0)/1000)/T)+(streak>=3?25:0)}else streak=0;
  el.querySelectorAll('[data-o]').forEach(b=>{b.disabled=true;if(b.dataset.o===q[2])b.classList.add('right');else if(b===btn)b.classList.add('wrong');else b.classList.add('dim')});
  setTimeout(()=>{i++;i<Q?ask():end()},right?900:1700)}
async function end(){el.innerHTML=`<div class="intro"><span class="qcat">Final score</span><div class="big">${score}</div><p class="muted" id="omsg">Saving…</p><div class="row"><button class="btn" id="go">Play again</button><a class="btn ghost" href="/play/">Race friends</a></div></div>`;
  document.getElementById('go').onclick=start;document.getElementById('omsg').innerHTML=score>0?await G.submit('trivia',score):'Better luck next time.'}
intro();
G.boardBox(document.getElementById('lb'),'trivia');

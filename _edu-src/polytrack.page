@@ meta
dir: polytrack
title: PolyTrack · Kale's Games
desc: PolyTrack, the low-poly racing game by Kodub, playable right here through itch.io. Loops, jumps and every millisecond counts.
page: polytrack
game: polytrack
@@ css
.pt{width:100%;max-width:960px;display:grid;gap:12px}
.frame{position:relative;width:100%;aspect-ratio:16/9;border-radius:22px;overflow:hidden;background:#1b1f1a;isolation:isolate}
.frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:block;background:#1b1f1a}
.frame:fullscreen{border-radius:0;background:#000}
.frame:fullscreen iframe{background:#000}
.cover{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:24px;color:#fff;background:
  radial-gradient(circle at 30% 20%,#4f8a4a55,transparent 40%),radial-gradient(circle at 80% 80%,#3B6FE055,transparent 45%),#1b1f1a;cursor:pointer}
.cover h2{font:800 clamp(32px,8vw,64px)/1 var(--display);letter-spacing:-.04em;color:#fff}
.cover p{color:#cfd6cb;margin-top:10px;font-weight:600;font-size:15px}
.cover .road{position:absolute;left:-10%;right:-10%;bottom:12%;height:22%;background:#2b3a23;transform:rotate(-6deg);border-top:4px dashed #cfd6cb55;border-bottom:6px solid #141613;z-index:-1}
.cover .go{display:inline-block;margin-top:18px;background:#fff;color:#141613;font-weight:700;padding:14px 26px;border-radius:999px;font-size:16px}
.cover:hover .go,.cover:focus-visible .go{transform:translateY(-1px)}
.ptbar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between;width:100%}
.ptbar .row{gap:8px}
.credit{display:grid;gap:6px;font-size:14px;color:var(--ink2);width:100%}
.credit a{text-decoration:underline}
.credit b{color:var(--ink)}
.keys{display:flex;gap:6px;flex-wrap:wrap}
.keys span{padding:6px 10px;border-radius:10px;background:var(--paper);font-weight:600;font-size:13px}
@media (max-width:600px){.frame{aspect-ratio:auto;height:62vh;min-height:300px}}
@media (prefers-reduced-motion:reduce){.cover .go{transition:none}}

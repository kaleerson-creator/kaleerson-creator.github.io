@@ js
const SRC='https://itch.io/embed-upload/19260993?color=1b1f1a';
const frame=document.getElementById('frame'),cover=document.getElementById('cover'),full=document.getElementById('full'),reload=document.getElementById('reload');
let game=null;
function start(){
  if(game)return;
  game=document.createElement('iframe');
  game.src=SRC;game.title='PolyTrack by Kodub';game.setAttribute('allowfullscreen','');game.allow='autoplay; fullscreen; gamepad';game.loading='eager';
  frame.append(game);cover.remove();full.hidden=false;reload.hidden=false;
  setTimeout(()=>{try{game.focus()}catch(e){}},300);
}
cover.addEventListener('click',start);
cover.addEventListener('keydown',e=>{if(e.key==='Enter'||e.key===' '){e.preventDefault();start()}});
reload.addEventListener('click',()=>{if(game){game.src=SRC}});
const canFull=!!(frame.requestFullscreen||frame.webkitRequestFullscreen);
if(!canFull)full.textContent='Open on itch.io for fullscreen';
full.addEventListener('click',()=>{
  if(!canFull){window.open('https://kodub.itch.io/polytrack','_blank','noopener');return}
  const el=document.fullscreenElement||document.webkitFullscreenElement;
  if(el){(document.exitFullscreen||document.webkitExitFullscreen).call(document)}
  else{(frame.requestFullscreen||frame.webkitRequestFullscreen).call(frame).catch(()=>{})}
});
document.addEventListener('fullscreenchange',()=>{full.textContent=document.fullscreenElement?'Exit fullscreen':'Fullscreen'});

@@ meta
dir: leaderboards
title: Leaderboards · Kale's Games
desc: Top scores for every game.
page: boards
@@ css
.boards{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:var(--gap)}
.box h2 a:hover{text-decoration:underline}
@@ body
<div class="ghead"><div><h1>Leaderboards</h1><p>Each person's best score. Times count when lower is better.</p></div>
  <div class="seg" id="per"><button data-p="day">Today</button><button data-p="week" aria-pressed="true">This week</button><button data-p="all">All time</button></div></div>
<div class="boards" id="boards"></div>
<p class="small" style="margin-top:var(--gap)" id="who"></p>
@@ js
const GAMES=[['word','Daily Word'],['daily','Daily Challenge'],['2048','2048'],['snake','Snake'],['minesweeper','Minesweeper (Medium)'],['sudoku','Sudoku (Medium)'],['typing','Typing (60s)'],['trivia','Trivia'],['letters','Letter Rush']];
let period='week';
function load(){document.getElementById('boards').innerHTML=GAMES.map(([g,n])=>`<div class="box"><h2><a href="/edu/${g}/">${n}</a></h2><div data-b="${g}"></div></div>`).join('');
  GAMES.forEach(([g])=>G.board(document.querySelector(`[data-b="${g}"]`),g,period))}
document.querySelectorAll('#per [data-p]').forEach(b=>b.onclick=()=>{period=b.dataset.p;document.querySelectorAll('#per [data-p]').forEach(x=>x.setAttribute('aria-pressed',x===b));load()});
load();
G.me.ready.then(m=>{document.getElementById('who').innerHTML=m.uid?'You\'re signed in as <b>'+G.esc(m.name||'(no name yet)')+'</b>.':'<a href="/join/?next=/edu/leaderboards/" style="text-decoration:underline">Sign in</a> so your scores count.'});

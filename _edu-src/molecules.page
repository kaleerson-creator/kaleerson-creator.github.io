@@ meta
dir: molecules
title: Happy Molecules · Games
desc: Every atom has a rule. Connect them until everyone is happy.
page: molecules
game: molecules
@@ css
.stage{position:relative}
.mbox{position:relative;width:100%;max-width:460px}
.legend .mol{cursor:default}
.mol{display:block;width:100%;height:auto;touch-action:none;user-select:none;-webkit-user-select:none;-webkit-tap-highlight-color:transparent;cursor:pointer}
.mol .f-blue{fill:var(--sky)}.mol .f-yellow{fill:var(--butter)}.mol .f-red{fill:var(--peach)}.mol .f-green{fill:var(--moss)}.mol .f-purple{fill:var(--lilac)}
html[data-theme=dark] .mol .f-blue{fill:#2E4F86}html[data-theme=dark] .mol .f-yellow{fill:#85741E}html[data-theme=dark] .mol .f-red{fill:#8E3E2E}html[data-theme=dark] .mol .f-green{fill:#3E6B32}html[data-theme=dark] .mol .f-purple{fill:#5B4A8F}
.mol .shape{stroke:var(--ink);stroke-width:2;stroke-linejoin:round}
.mol .face{fill:var(--ink)}
.mol .mouth{fill:none;stroke:var(--ink);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.mol .bond{stroke:var(--ink);stroke-width:4;stroke-linecap:round;opacity:.75}
.mol .bond.hint{stroke:#d8b43a}
.mol .ghost{stroke:var(--ink3);stroke-width:4;stroke-dasharray:6 7;stroke-linecap:round;pointer-events:none}
.mol .sel{fill:none;stroke:var(--ink);stroke-width:3;stroke-dasharray:5 5}
.mol .hit{fill:transparent;stroke:none}
.mol .handle{fill:var(--card);stroke:var(--ink);stroke-width:2}
.mol .hwrap:hover .handle{fill:var(--peach)}
.mol .gback{fill:var(--card);opacity:.92}
.mol .gtxt{font:700 11px var(--body);fill:var(--ink)}
.mol .gi{stroke:var(--ink);stroke-width:1.5;stroke-linejoin:round;fill:var(--card)}
.mol .gi.st{stroke-width:1}
.mol .link{stroke:var(--ink);stroke-width:2;stroke-linecap:round}
.mol .dot{fill:var(--ink)}
.mol .slash{stroke:#D12C2C;stroke-width:2.5;stroke-linecap:round}
html[data-theme=dark] .mol .slash{stroke:#f08a7c}
.mol .wig{transform-box:fill-box;transform-origin:center;animation:wig .5s var(--ease)}
@keyframes wig{0%,100%{transform:rotate(0)}30%{transform:rotate(-8deg) scale(1.06)}70%{transform:rotate(7deg) scale(1.04)}}
.mtop{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;width:100%;max-width:460px}
.pill{display:inline-flex;align-items:center;gap:6px;padding:7px 13px;border-radius:999px;background:var(--paper);color:var(--ink);font-weight:600;font-size:14px;font-variant-numeric:tabular-nums}
.pill.full{background:var(--moss)}
.rule{min-height:44px;width:100%;max-width:460px;text-align:center;font-size:14px;color:var(--ink2);background:var(--paper);border-radius:14px;padding:10px 12px}
.rule b{color:var(--ink)}
.levels{display:flex;gap:6px;overflow-x:auto;max-width:100%;padding:2px;scrollbar-width:thin}
.levels button{flex:none;min-width:36px;height:32px;border:0;border-radius:999px;background:var(--paper);color:var(--ink2);font:600 13px var(--body);cursor:pointer;padding:0 10px}
.levels button.done{background:var(--moss);color:var(--ink)}
.levels button[aria-pressed=true]{background:var(--ink);color:var(--on-ink)}
.legend{display:grid;gap:6px;font-size:14px;color:var(--ink2)}
.legend svg{width:22px;height:22px;vertical-align:middle;margin-right:6px}
.big{font:800 56px/1 var(--display);letter-spacing:-.04em}

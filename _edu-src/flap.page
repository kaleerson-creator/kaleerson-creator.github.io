@@ meta
dir: flap
title: Flap · Kale's Games
desc: Tap to flap through the gaps. The gaps get smaller.
page: flap
game: flap
@@ css
.gbox{position:relative;width:min(100%,480px);--bg:var(--sky);--pipe:#5E9A52;--pipe2:#4A7F41;--ground:var(--moss);--bird:var(--butter);--wing:var(--peach);--beak:#E98A5A}
html[data-theme=dark] .gbox{--bg:#16202e;--pipe:#4C8542;--pipe2:#3B6B33;--ground:#26351F;--bird:#F2D45E;--wing:#F39A82;--beak:#E98A5A}
canvas{width:100%;aspect-ratio:3/4;display:block;border-radius:20px;background:var(--bg);touch-action:none;user-select:none;-webkit-user-select:none;cursor:pointer}
html[data-theme=dark] .gbox .over{background:#111310cc}
.help{font-size:13px;color:var(--ink2);text-align:center}
@media (pointer:coarse){.help{display:none}}
@@ body
<div class="ghead"><div><h1>Flap</h1><p>Tap to flap through the gaps. They get smaller.</p></div><button class="btn sm ghost" id="restart">Restart</button></div>
<div class="glay">
  <div class="stage">
    <div class="stats"><div><b id="score">0</b><span>Pipes</span></div><div><b id="best">0</b><span>Best</span></div></div>
    <div class="gbox" id="gbox"><canvas id="c" width="480" height="640"></canvas></div>
    <p class="help">Click, tap or press Space to flap</p>
  </div>
  <div class="side"><div class="box" id="lb"></div></div>
</div>
@@ js
const cv=document.getElementById('c'),ctx=cv.getContext('2d'),box=document.getElementById('gbox');
const LW=300,LH=400,GROUND=36,BX=72,BR=13,PW=52,SPACING=175,SPEED=135,GRAV=1500,FLAP=-380;
const $=id=>document.getElementById(id);
let state,bird,pipes,score,tm,raf,last,carry,ground;
function gap(){return Math.max(90,124-score*1.4)}
function reset(){state='idle';bird={y:LH/2,vy:0,rot:0};pipes=[];score=0;tm=0;ground=0;last=0;carry=0;document.querySelectorAll('.over').forEach(o=>o.remove());stats();cancelAnimationFrame(raf);raf=requestAnimationFrame(frame)}
function stats(){$('score').textContent=score;$('best').textContent=Math.max(G.local.get('best:flap',0)||0,score)}
function addPipe(x){const g=gap();const top=50+Math.random()*(LH-GROUND-100-g);pipes.push({x,top,bot:top+g,passed:false})}
function flap(){if(state==='dead')return;if(state==='idle'){state='play';pipes=[];addPipe(LW+60);bird.vy=FLAP;return}bird.vy=FLAP}
function step(dt){const s=dt/1000;tm+=s;ground=(ground+SPEED*s)%24;
  if(state==='idle'){bird.y=LH/2+Math.sin(tm*3)*6;bird.rot=0;return}
  bird.vy+=GRAV*s;bird.y+=bird.vy*s;bird.rot=Math.max(-.5,Math.min(1.3,bird.vy/500));
  for(const p of pipes){p.x-=SPEED*s;if(!p.passed&&p.x+PW<BX){p.passed=true;score++;stats()}}
  if(pipes.length&&pipes[pipes.length-1].x<LW-SPACING)addPipe(pipes[pipes.length-1].x+SPACING);
  if(pipes.length&&pipes[0].x+PW<-10)pipes.shift();
  if(bird.y+BR>=LH-GROUND){bird.y=LH-GROUND-BR;return die()}
  if(bird.y-BR<0){bird.y=BR;bird.vy=0}
  for(const p of pipes){if(BX+BR*.8>p.x&&BX-BR*.8<p.x+PW&&(bird.y-BR*.8<p.top||bird.y+BR*.8>p.bot))return die()}}
const STEP=1000/60;
function frame(ts){if(state==='dead'||document.hidden)return;if(!last)last=ts;let dt=Math.min(250,ts-last);last=ts;carry+=dt;while(carry>=STEP){step(STEP);carry-=STEP;if(state==='dead')break}draw();if(state!=='dead')raf=requestAnimationFrame(frame)}
async function die(){state='dead';cancelAnimationFrame(raf);draw();const o=document.createElement('div');o.className='over';const txt=score+' pipe'+(score===1?'':'s');o.innerHTML=`<div><h2>Game over</h2><p class="muted" id="omsg">${txt}${score>0?' · saving…':''}</p><div data-actions></div><button class="btn" id="ogo">Play again</button></div>`;box.append(o);o.querySelector('#ogo').onclick=reset;if(score>0)o.querySelector('#omsg').innerHTML=txt+'<br>'+await G.submit('flap',score,{});stats()}
// drawing
let dpr=1,sc=1,W=0,H=0;
function size(){dpr=Math.min(3,window.devicePixelRatio||1);W=cv.clientWidth||480;H=cv.clientHeight||Math.round(W*4/3);cv.width=Math.round(W*dpr);cv.height=Math.round(H*dpr);sc=Math.min(W/LW,H/LH);draw()}
function draw(){const st=getComputedStyle(box),tok=n=>st.getPropertyValue(n).trim();ctx.setTransform(dpr,0,0,dpr,0,0);ctx.clearRect(0,0,W,H);
  ctx.setTransform(dpr*sc,0,0,dpr*sc,dpr*(W-LW*sc)/2,0);
  // pipes
  for(const p of pipes){ctx.fillStyle=tok('--pipe');ctx.beginPath();ctx.roundRect(p.x,-10,PW,p.top+10,6);ctx.fill();ctx.beginPath();ctx.roundRect(p.x,p.bot,PW,LH-GROUND-p.bot+10,6);ctx.fill();
    ctx.fillStyle=tok('--pipe2');ctx.beginPath();ctx.roundRect(p.x-3,p.top-14,PW+6,14,5);ctx.fill();ctx.beginPath();ctx.roundRect(p.x-3,p.bot,PW+6,14,5);ctx.fill()}
  // ground
  ctx.fillStyle=tok('--ground');ctx.fillRect(0,LH-GROUND,LW,GROUND+10);ctx.fillStyle=tok('--pipe2');ctx.globalAlpha=.35;for(let x=-ground;x<LW;x+=24)ctx.fillRect(x,LH-GROUND,12,4);ctx.globalAlpha=1;
  // bird
  ctx.save();ctx.translate(BX,bird.y);ctx.rotate(bird.rot);
  ctx.fillStyle=tok('--bird');ctx.beginPath();ctx.ellipse(0,0,BR+2,BR,0,0,7);ctx.fill();
  ctx.fillStyle=tok('--wing');ctx.beginPath();ctx.ellipse(-4,3,7,4.5,-.3+(state==='play'?Math.sin(tm*25)*.4:Math.sin(tm*6)*.3),0,7);ctx.fill();
  ctx.fillStyle=tok('--beak');ctx.beginPath();ctx.moveTo(BR-2,-2);ctx.lineTo(BR+8,1);ctx.lineTo(BR-2,4);ctx.closePath();ctx.fill();
  ctx.fillStyle=tok('--card');ctx.beginPath();ctx.arc(5,-4,4,0,7);ctx.fill();ctx.fillStyle=tok('--ink');ctx.beginPath();ctx.arc(6,-4,2,0,7);ctx.fill();
  ctx.restore();
  // text
  ctx.fillStyle=tok('--ink');ctx.textAlign='center';ctx.textBaseline='top';
  if(state==='idle'){ctx.font='800 30px '+(tok('--display')||'sans-serif');ctx.fillText('Tap to start',LW/2,LH*.22);ctx.font='600 13px '+(tok('--body')||'sans-serif');ctx.fillStyle=tok('--ink2');ctx.fillText('Click, tap or press Space',LW/2,LH*.22+38)}
  else{ctx.font='800 40px '+(tok('--display')||'sans-serif');ctx.globalAlpha=.9;ctx.fillText(score,LW/2,18);ctx.globalAlpha=1}}
// input
document.addEventListener('keydown',e=>{if(e.target&&e.target.closest&&e.target.closest('input,textarea,select'))return;if(e.key!==' '&&e.key!=='ArrowUp'&&e.key.toLowerCase()!=='w')return;if(e.key===' '&&e.target&&e.target.closest&&e.target.closest('.over button'))return;e.preventDefault();if(e.repeat)return;flap()});
cv.addEventListener('pointerdown',e=>{e.preventDefault();flap()});
$('restart').onclick=reset;
document.addEventListener('visibilitychange',()=>{if(document.hidden){cancelAnimationFrame(raf)}else if(state!=='dead'){last=0;cancelAnimationFrame(raf);raf=requestAnimationFrame(frame)}});
document.addEventListener('themechange',draw);
new ResizeObserver(size).observe(cv);
reset();size();
G.boardBox(document.getElementById('lb'),'flap');

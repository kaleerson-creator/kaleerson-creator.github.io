@@ meta
dir: tuxracer
title: TuxRacer.js · Kale's Games
desc: TuxRacer.js by Jan Ebbe: the classic Tux Racer penguin sledding game rebuilt for the browser. Arrow keys or WASD, touch joystick on phones. Hosted on kaleerson.com.
page: tuxracer
game: g3d-tuxracer
@@ css
.g3{width:100%;max-width:1100px;display:grid;gap:12px}
.frame{position:relative;width:100%;aspect-ratio:16/9;border-radius:22px;overflow:hidden;background:#0f1210;isolation:isolate}
.frame iframe{position:absolute;inset:0;width:100%;height:100%;border:0;display:block;background:#0f1210}
.frame:fullscreen{border-radius:0;background:#000}
.cover{position:absolute;inset:0;display:grid;place-items:center;text-align:center;padding:24px;color:#fff;cursor:pointer;background:radial-gradient(circle at 25% 25%,#3B6FE066,transparent 45%),radial-gradient(circle at 80% 75%,#4f8a4a55,transparent 45%),#0f1210}
.cover h2{font:800 clamp(34px,8vw,72px)/.95 var(--display);letter-spacing:-.04em;color:#fff}
.cover p{color:#cfd6cb;margin-top:10px;font-weight:600;font-size:15px;max-width:46ch}
.cover .go{display:inline-block;margin-top:18px;background:#fff;color:#141613;font-weight:700;padding:14px 28px;border-radius:999px;font-size:16px}
.cover small{display:block;margin-top:14px;color:#9aa397;font-size:12px}
.g3bar{display:flex;gap:8px;flex-wrap:wrap;align-items:center;justify-content:space-between;width:100%}
.keys{display:flex;gap:6px;flex-wrap:wrap}
.keys span{padding:6px 10px;border-radius:10px;background:var(--paper);font-weight:600;font-size:13px}
.credit{display:grid;gap:6px;font-size:14px;color:var(--ink2);width:100%}
.credit a{text-decoration:underline}.credit b{color:var(--ink)}
.focus{display:none;font-size:13px;color:var(--ink2)}
.started .focus{display:block}
@media (max-width:600px){.frame{aspect-ratio:auto;height:64vh;min-height:320px}}
@@ body
<div class="ghead"><div><h1>TuxRacer.js</h1><p>Tux the penguin belly-slides down a mountain grabbing fish.</p></div><a class="btn sm ghost" href="https://github.com/ebbejan/tux-racer-js" target="_blank" rel="noopener">Source &amp; license ↗</a></div>
<div class="stage">
  <div class="g3" id="g3">
    <div class="frame" id="frame">
      <div class="cover" id="cover" role="button" tabindex="0" aria-label="Play TuxRacer.js"><div><h2>TuxRacer.js</h2><p>Steer Tux down the hill, grab as many fish as you can and try not to fly off a cliff. It&#x27;s the old Tux Racer game rebuilt for the browser, and it starts the second it loads.</p><span class="go">Play</span><small>About 10 MB to load the first time. Works with touch.</small></div></div>
    </div>
    <div class="g3bar">
      <div class="keys" aria-label="Controls"><span>← → or A/D: steer</span><span>↑ or W: paddle (speed up)</span><span>↓ or S: brake</span><span>Phone: drag the joystick</span></div>
      <div class="row"><button class="btn sm ghost" id="reload" hidden>Restart</button><button class="btn sm" id="full" hidden>Fullscreen</button></div>
    </div>
    <p class="focus">If the keys do nothing, click inside the game once.</p>
    <div class="credit">
      <span><b>TuxRacer.js</b> is by <a href="https://github.com/ebbejan" target="_blank" rel="noopener">Jan Ebbe</a> and is shared under the GPL-2.0 license (<a href="/edu/3d/tuxracer/LICENSE" target="_blank">read it</a>). I host a copy here so it works on school Wi-Fi; the original is at <a href="https://github.com/ebbejan/tux-racer-js" target="_blank" rel="noopener">github.com</a>.</span>
      <span>Nothing from this game is saved to your kaleerson.com account. It&#x27;s a remake of Extreme Tux Racer, so the courses, music and art come from that team too.</span>
    </div>
  </div>
</div>
@@ js
const SRC='/edu/3d/tuxracer/index.html';
const frame=document.getElementById('frame'),cover=document.getElementById('cover'),full=document.getElementById('full'),reload=document.getElementById('reload'),g3=document.getElementById('g3');
let game=null;
function start(){
  if(game)return;
  game=document.createElement('iframe');
  game.src=SRC;game.title="TuxRacer.js";game.setAttribute('allowfullscreen','');game.allow='autoplay; fullscreen; gamepad; pointer-lock';
  frame.append(game);cover.remove();full.hidden=false;reload.hidden=false;g3.classList.add('started');
  setTimeout(()=>{try{game.focus()}catch(e){}},300);
}
cover.addEventListener('click',start);
cover.addEventListener('keydown',ev=>{if(ev.key==='Enter'||ev.key===' '){ev.preventDefault();start()}});
reload.addEventListener('click',()=>{if(game){game.src=SRC}});
const canFull=!!(frame.requestFullscreen||frame.webkitRequestFullscreen);
if(!canFull)full.hidden=true;
full.addEventListener('click',()=>{
  const el=document.fullscreenElement||document.webkitFullscreenElement;
  if(el){(document.exitFullscreen||document.webkitExitFullscreen).call(document)}
  else{(frame.requestFullscreen||frame.webkitRequestFullscreen).call(frame).catch(()=>{});setTimeout(()=>{try{game&&game.focus()}catch(e){}},200)}
});
document.addEventListener('fullscreenchange',()=>{full.textContent=document.fullscreenElement?'Exit fullscreen':'Fullscreen'});

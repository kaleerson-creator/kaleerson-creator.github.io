@@ meta
dir: connect
title: Connect Four · Kale's Games
desc: Four in a row beats the computer. Easy, Hard, or pass the phone to a friend.
page: connect
game: connect
@@ css
.cbox{position:relative;width:min(100%,440px);display:grid;gap:8px}
.cols{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;padding:0 10px}
.cols button{min-height:44px;border:0;border-radius:12px;background:var(--paper);color:var(--ink);font:700 15px/1 var(--display);cursor:pointer;padding:0;touch-action:manipulation}
.cols button:disabled{opacity:.4;cursor:default}
.cols button:not(:disabled):hover{background:var(--line)}
.c4{display:grid;grid-template-columns:repeat(7,1fr);gap:6px;background:#2451C9;padding:10px;border-radius:20px;touch-action:manipulation}
.cell{aspect-ratio:1;border-radius:50%;background:var(--card);position:relative;cursor:pointer;overflow:visible}
.piece{position:absolute;inset:0;border-radius:50%}
.piece.R{background:#D12C2C}.piece.Y{background:#F3C93B}
.piece.drop{animation:drop .35s cubic-bezier(.3,.9,.4,1.1) both}
@keyframes drop{from{transform:translateY(calc(-1 * var(--d) * (100% + 6px)))}}
.piece.win{box-shadow:inset 0 0 0 5px #fff;animation:none}
.c4.done .cell{cursor:default}
.turn{display:flex;align-items:center;gap:8px;font-weight:600;min-height:24px;justify-content:center}
.turn i{width:16px;height:16px;border-radius:50%;display:inline-block}
.turn i.R{background:#D12C2C}.turn i.Y{background:#F3C93B}
.over .pc{width:40px;height:40px;border-radius:50%;display:inline-block}
.over .pc.R{background:#D12C2C}.over .pc.Y{background:#F3C93B}
@@ body
<div class="ghead"><div><h1>Connect Four</h1><p>Drop pieces, get four in a row. Tap a column or press 1 to 7. Hard wins count for the leaderboard.</p></div>
  <div class="seg" id="mode"><button data-m="easy">Easy</button><button data-m="hard" aria-pressed="true">Hard</button><button data-m="pass">Pass &amp; play</button></div></div>
<div class="glay">
  <div class="stage">
    <div class="stats"><div><b id="streak">0</b><span>Hard wins in a row</span></div><div><b id="best">–</b><span>Best</span></div></div>
    <div class="cbox" id="cbox">
      <div class="turn" id="turn"></div>
      <div class="cols" id="cols"></div>
      <div class="c4" id="board"></div>
    </div>
    <button class="btn sm ghost" id="restart">New game</button>
  </div>
  <div class="side">
    <div class="box"><h2>How it works</h2><p class="muted">You're red. Easy plays quick and a bit random. Hard looks five moves ahead, so plan your traps. Pass &amp; play is two people on one phone. Beat Hard a few times in a row to climb the board.</p></div>
    <div class="box" id="lb"></div>
  </div>
</div>
@@ js
const ROWS=6,COLS=7,$=id=>document.getElementById(id);
const WIN=[];
for(let r=0;r<ROWS;r++)for(let c=0;c<COLS;c++)for(const [dr,dc] of [[0,1],[1,0],[1,1],[1,-1]]){
  const w=[];for(let k=0;k<4;k++){const R=r+dr*k,C=c+dc*k;if(R<0||R>=ROWS||C<0||C>=COLS)break;w.push(R*COLS+C)}if(w.length===4)WIN.push(w)}
const AT=[...Array(42)].map((_,i)=>WIN.filter(w=>w.includes(i)));
const ORDER=[3,2,4,1,5,0,6];
let board,turn,done,mode='hard',starter='R',busy=false,lastIdx=-1,line=null;
let streak=G.local.get('connect:streak',0)||0;
function place(b,c,p){for(let r=ROWS-1;r>=0;r--){const i=r*COLS+c;if(!b[i]){b[i]=p;return i}}return -1}
function winAt(b,i){const p=b[i];for(const w of AT[i])if(w.every(j=>b[j]===p))return w;return null}
function full(b){for(let c=0;c<COLS;c++)if(!b[c])return false;return true}
function heur(b,ai){const hu=ai==='R'?'Y':'R';let s=0;
  for(const w of WIN){let a=0,h=0;for(const j of w){if(b[j]===ai)a++;else if(b[j]===hu)h++}
    if(a&&h)continue;if(a===3)s+=40;else if(a===2)s+=8;else if(h===3)s-=50;else if(h===2)s-=8}
  for(let r=0;r<ROWS;r++){const v=b[r*COLS+3];if(v===ai)s+=5;else if(v===hu)s-=5}
  return s}
function search(b,depth,alpha,beta,t,ai,last){
  if(last>=0&&winAt(b,last))return b[last]===ai?100000+depth:-100000-depth;
  if(depth===0)return heur(b,ai);
  const other=t==='R'?'Y':'R';let any=false,best=t===ai?-Infinity:Infinity;
  for(const c of ORDER){if(b[c])continue;any=true;const i=place(b,c,t);const v=search(b,depth-1,alpha,beta,other,ai,i);b[i]='';
    if(t===ai){if(v>best)best=v;if(best>alpha)alpha=best}else{if(v<best)best=v;if(best<beta)beta=best}
    if(alpha>=beta)break}
  return any?best:0}
function instant(b,p){for(const c of ORDER){if(b[c])continue;const i=place(b,c,p);const w=winAt(b,i);b[i]='';if(w)return c}return -1}
function aiMove(){
  const ai='Y',hu='R',b=board.slice();
  if(mode==='easy'){let c=instant(b,ai);if(c<0)c=instant(b,hu);if(c<0){const open=ORDER.filter(c=>!b[c]);c=open[Math.floor(Math.random()*open.length)]}return c}
  let bestV=-Infinity,bestC=[];
  for(const c of ORDER){if(b[c])continue;const i=place(b,c,ai);const v=search(b,5,-Infinity,Infinity,hu,ai,i);b[i]='';
    if(v>bestV){bestV=v;bestC=[c]}else if(v===bestV)bestC.push(c)}
  return bestC[Math.floor(Math.random()*bestC.length)]}
function who(p){return mode==='pass'?(p==='R'?'Red':'Yellow'):(p==='R'?'You':'Computer')}
function draw(){
  $('board').innerHTML=board.map((v,i)=>`<div class="cell" data-c="${i%COLS}">${v?`<div class="piece ${v}${i===lastIdx?' drop':''}${line&&line.includes(i)?' win':''}" style="--d:${Math.floor(i/COLS)+1}"></div>`:''}</div>`).join('');
  $('board').classList.toggle('done',done);
  $('cols').innerHTML=[...Array(COLS)].map((_,c)=>`<button data-c="${c}" aria-label="Drop in column ${c+1}"${done||board[c]||busy?' disabled':''}>${c+1}</button>`).join('');
  $('turn').innerHTML=done?'':`<i class="${turn}"></i>${busy?'Computer is thinking…':who(turn)+(mode==='pass'?"'s turn":' to move')}`;
  $('streak').textContent=streak;const b=G.local.get('best:connect',null);$('best').textContent=b===null?'–':b;
}
function start(){document.querySelectorAll('.over').forEach(o=>o.remove());board=Array(42).fill('');turn=starter;starter=starter==='R'?'Y':'R';done=false;busy=false;lastIdx=-1;line=null;draw();
  if(mode!=='pass'&&turn==='Y')computer()}
function move(c){
  if(done||busy||board[c])return;
  const i=place(board,c,turn);lastIdx=i;const w=winAt(board,i);
  if(w){line=w;done=true;draw();return finish(turn)}
  if(full(board)){done=true;draw();return finish(null)}
  turn=turn==='R'?'Y':'R';draw();
  if(mode!=='pass'&&turn==='Y')computer()}
function computer(){busy=true;draw();setTimeout(()=>{if(done)return;const c=aiMove();busy=false;move(c)},mode==='hard'?350:250)}
async function finish(winner){
  const o=document.createElement('div');o.className='over';
  let title,sub='';
  if(!winner){title='Draw';sub='The board filled up.'}
  else if(mode==='pass')title=(winner==='R'?'Red':'Yellow')+' wins';
  else if(winner==='R')title='You win';else title='Computer wins';
  const hardWin=mode==='hard'&&winner==='R';
  if(mode==='hard'){if(hardWin)streak++;else streak=0;G.local.set('connect:streak',streak)}
  if(hardWin)sub=streak+' in a row · saving…';
  else if(mode==='hard'&&winner==='Y')sub='Hard wins in a row reset.';
  else if(mode==='easy'&&winner==='R')sub='Nice. Try Hard to get on the leaderboard.';
  o.innerHTML=`<div>${winner?`<span class="pc ${winner}"></span>`:''}<h2>${title}</h2><p class="muted" id="omsg">${sub}</p><div data-actions></div><button class="btn" id="oagain">Play again</button></div>`;
  $('cbox').append(o);o.querySelector('#oagain').onclick=start;draw();
  if(hardWin){if(window.SITE&&SITE.confetti)SITE.confetti();const msg=await G.submit('connect',Math.min(200,streak),{mode:'hard'});const m=o.querySelector('#omsg');if(m)m.innerHTML=streak+' in a row'+(msg?'<br>'+msg:'');draw()}
}
$('board').addEventListener('click',e=>{const c=e.target.closest('[data-c]');if(c&&(mode==='pass'||turn==='R'))move(+c.dataset.c)});
$('cols').addEventListener('click',e=>{const b=e.target.closest('button[data-c]');if(b&&!b.disabled&&(mode==='pass'||turn==='R'))move(+b.dataset.c)});
$('mode').addEventListener('click',e=>{const b=e.target.closest('[data-m]');if(!b||b.dataset.m===mode)return;mode=b.dataset.m;$('mode').querySelectorAll('button').forEach(x=>x.setAttribute('aria-pressed',x===b));starter='R';start()});
$('restart').onclick=start;
document.addEventListener('keydown',e=>{if(e.ctrlKey||e.metaKey||e.altKey||e.target.matches('input,textarea'))return;
  if(/^[1-7]$/.test(e.key)){e.preventDefault();if(mode==='pass'||turn==='R')move(+e.key-1)}
  else if(e.key==='Enter'&&done&&!e.target.matches('button,a')){const b=document.getElementById('oagain');if(b){e.preventDefault();b.click()}}});
start();
G.boardBox(document.getElementById('lb'),'connect');

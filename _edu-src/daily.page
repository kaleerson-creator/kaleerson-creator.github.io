@@ meta
dir: daily
title: Daily Challenge · Kale's Games
desc: The same 10 trivia questions for everyone today. One try. See where you rank.
page: daily
game: daily
scripts: /assets/trivia.js
@@ css
.tq{width:100%;max-width:640px;display:grid;gap:14px;position:relative;min-height:380px;align-content:start}
.tbar{height:8px;background:var(--paper);border-radius:99px;overflow:hidden}
.tbar i{display:block;height:100%;background:var(--forest);width:100%;transition:width .2s linear}
.qcat{font-size:12px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ink2)}
.qtext{font:800 clamp(22px,3.4vw,32px)/1.15 var(--display);letter-spacing:-.025em}
.opts{display:grid;grid-template-columns:1fr 1fr;gap:10px}
@media (max-width:560px){.opts{grid-template-columns:1fr}}
.opts button{border:0;border-radius:16px;padding:16px;font:600 16px/1.3 var(--body);text-align:left;cursor:pointer;background:var(--paper);color:var(--ink)}
.opts button:nth-child(1){background:var(--sky)}.opts button:nth-child(2){background:var(--peach)}.opts button:nth-child(3){background:var(--moss)}.opts button:nth-child(4){background:var(--lilac)}
.opts button.right{background:#4f8a4a;color:#fff}.opts button.wrong{background:#D12C2C;color:#fff}.opts button.dim{opacity:.45}
.intro{display:grid;gap:12px;justify-items:start}
.big{font:800 64px/1 var(--display);letter-spacing:-.04em}
.dots{display:flex;gap:6px;flex-wrap:wrap}
.dots i{width:22px;height:22px;border-radius:7px;background:var(--paper)}
.dots i.y{background:#4f8a4a}.dots i.n{background:#D12C2C}
.cal{display:grid;grid-template-columns:repeat(10,1fr);gap:5px}
.cal i{aspect-ratio:1;border-radius:6px;background:var(--paper)}
.cal i.p{background:#8fbf86}.cal i.hi{background:#4f8a4a}.cal i.today{box-shadow:inset 0 0 0 2px var(--ink)}
@@ body
<div class="ghead"><div><h1>Daily Challenge</h1><p>Same 10 questions for everyone today. You get one try, so make it count. New questions every day at midnight.</p></div><a class="btn sm ghost" href="/edu/trivia/">Practice trivia →</a></div>
<div class="glay">
  <div class="stage"><div class="tq" id="tq"></div></div>
  <div class="side">
    <div class="box"><h2>Your stats</h2><div class="stats" id="stats"></div><span class="lbl">Last 30 days</span><div class="cal" id="cal" aria-label="Days played in the last 30 days"></div></div>
    <div class="box" id="lb"></div>
  </div>
</div>
@@ js
const Q=10,T=15;let i,score,timer,t0,locked,marks;
const el=document.getElementById('tq');
const today=new Date().toLocaleDateString('en-CA',{timeZone:'America/Los_Angeles'});
const num=Math.round((Date.parse(today+'T00:00:00Z')-Date.UTC(2026,9,1))/864e5)+1;
const dayAgo=k=>new Date(Date.parse(today+'T12:00:00Z')-k*864e5).toISOString().slice(0,10);
// Seeded shuffle so everyone gets the same questions (and answer order) today.
function rng(seed){return()=>{seed|=0;seed=seed+0x6D2B79F5|0;let t=Math.imul(seed^seed>>>15,1|seed);t=t+Math.imul(t^t>>>7,61|t)^t;return((t^t>>>14)>>>0)/4294967296}}
function shuffle(a,r){a=a.slice();for(let k=a.length-1;k>0;k--){const j=Math.floor(r()*(k+1));[a[k],a[j]]=[a[j],a[k]]}return a}
const R=rng(num*7919+17);
const todays=shuffle(TRIVIA,R).slice(0,Q).map(q=>({cat:q[0],text:q[1],right:q[2],opts:shuffle(q.slice(2),R)}));
const done=()=>G.local.get('daily:'+today,null);
// Progress is saved after every question so a closed tab can pick the run back up.
const save=open=>G.local.set('daily:'+today,{score,marks:marks.concat(Array(Q-marks.length).fill(false)),n:marks.length,open:!!open,started:true});
function intro(){const d=done();
  if(d&&d.started&&!d.finished)return resume(d);
  if(d){const sk=G.streak('daily').count;
    el.innerHTML=`<div class="intro"><span class="qcat">Daily Challenge #${num}</span><div class="big">${d.score}</div><div class="dots">${d.marks.map(m=>`<i class="${m?'y':'n'}"></i>`).join('')}</div>
    <p class="muted">${d.marks.filter(Boolean).length}/10 right. Come back tomorrow for new questions.${sk>0?` <span class="streak">🔥 ${sk}-day streak</span>`:''}</p><div data-actions id="dacts" style="justify-content:flex-start"></div></div>`;
    G.actions(document.getElementById('dacts'),'daily',d.score,`Daily Challenge ${today}: ${d.score} pts\n${d.marks.map(m=>m?'🟩':'🟥').join('')}\nkaleerson.com/edu/daily`);
    statsBox();return}
  el.innerHTML=`<div class="intro"><span class="qcat">Daily Challenge #${num}</span><div class="qtext">10 questions. 15 seconds each. One try.</div><p class="muted">Faster correct answers score more. Ready?</p><button class="btn" id="go">Start</button></div>`;
  document.getElementById('go').onclick=start}
// The tab was closed mid-run. Continue from the next question; a question that was open counts as wrong.
function resume(d){const n=Math.min(Q,d.n==null?Q:d.n|0);score=d.score|0;marks=(d.marks||[]).slice(0,n);
  if(d.open&&marks.length<Q)marks.push(false);
  i=marks.length;if(i>=Q)return end();
  G.toast(d.open?'Resumed. The question you left counts as wrong.':'Resumed where you left off.');ask()}
function start(){i=0;score=0;marks=[];save(false);ask()}
function ask(){locked=false;const q=todays[i];save(true);
  el.innerHTML=`<div class="row" style="justify-content:space-between"><span class="qcat">${G.esc(q.cat)} · ${i+1}/${Q}</span><b>${score} pts</b></div><div class="tbar"><i id="bar"></i></div><div class="qtext">${G.esc(q.text)}</div>
    <div class="opts">${q.opts.map(o=>`<button data-o="${G.esc(o)}">${G.esc(o)}</button>`).join('')}</div>`;
  t0=Date.now();clearInterval(timer);timer=setInterval(()=>{const left=T-(Date.now()-t0)/1000;document.getElementById('bar').style.width=Math.max(0,100*left/T)+'%';if(left<=0)answer(null)},100);
  el.querySelectorAll('[data-o]').forEach(b=>b.onclick=()=>answer(b))}
function answer(btn){if(locked)return;locked=true;clearInterval(timer);const q=todays[i],right=btn&&btn.dataset.o===q.right;
  if(right)score+=100+Math.round(100*Math.max(0,T-(Date.now()-t0)/1000)/T);marks.push(!!right);save(false);
  el.querySelectorAll('[data-o]').forEach(b=>{b.disabled=true;if(b.dataset.o===q.right)b.classList.add('right');else if(b===btn)b.classList.add('wrong');else b.classList.add('dim')});
  setTimeout(()=>{i++;i<Q?ask():end()},right?900:1700)}
async function end(){clearInterval(timer);G.local.set('daily:'+today,{score,marks,finished:true});G.bump('daily');intro();
  const p=document.createElement('p');p.className='muted';p.textContent='Saving…';el.querySelector('.intro').append(p);p.innerHTML=await G.submit('daily',score)}
// Played / average / best / streak, plus a dot per day for the last 30 days (from g:daily:<date>).
function statsBox(){
  const played=G.local.keys('daily:').map(k=>k.slice(6)).filter(k=>/^\d{4}-\d{2}-\d{2}$/.test(k)).map(k=>[k,G.local.get('daily:'+k,null)]).filter(([,d])=>d&&d.finished);
  const sc=played.map(([,d])=>d.score|0),avg=sc.length?Math.round(sc.reduce((a,b)=>a+b,0)/sc.length):0,best=sc.length?Math.max(...sc):0;
  document.getElementById('stats').innerHTML=`<div><b>${sc.length}</b><span>Played</span></div><div><b>${avg}</b><span>Average</span></div><div><b>${best}</b><span>Best</span></div><div><b>${G.streak('daily').count}</b><span>Streak</span></div>`;
  const by={};played.forEach(([k,d])=>by[k]=d.score|0);
  document.getElementById('cal').innerHTML=[...Array(30)].map((_,k)=>{const d=dayAgo(29-k),s=by[d];return `<i class="${s===undefined?'':s>=1500?'hi':'p'}${d===today?' today':''}" title="${d}${s===undefined?'':': '+s+' pts'}"></i>`}).join('')}
// People who played before streaks existed: rebuild the streak from saved days.
if(!G.local.get('streak:daily',null)){let c=0,last=null;for(let k=0;k<400;k++){const d=dayAgo(k),x=G.local.get('daily:'+d,null);if(x&&x.finished){c++;last=last||d}else if(k===0)continue;else break}
  if(c)G.local.set('streak:daily',{count:c,last})}
statsBox();
intro();
G.boardBox(document.getElementById('lb'),'daily','day');

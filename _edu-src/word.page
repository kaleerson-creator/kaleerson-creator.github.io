@@ meta
dir: word
title: Daily Word · Kale's Games
desc: Guess the five-letter word in six tries. New word every day.
page: word
game: word
scripts: /assets/words.js
@@ css
.wgrid{display:grid;grid-template-rows:repeat(6,1fr);gap:6px;width:min(100%,330px)}
.wrow{display:grid;grid-template-columns:repeat(5,1fr);gap:6px}
.wrow.shake{animation:shake .35s}
@keyframes shake{20%,60%{transform:translateX(-6px)}40%,80%{transform:translateX(6px)}}
.wc{aspect-ratio:1;border:2px solid var(--line);border-radius:10px;display:grid;place-items:center;font:800 clamp(24px,7vw,32px)/1 var(--display);text-transform:uppercase;background:#fff}
.wc.f{border-color:var(--ink3)}
.wc.g{background:#4f8a4a;border-color:#4f8a4a;color:#fff}.wc.y{background:#d8b43a;border-color:#d8b43a;color:#fff}.wc.x{background:#8f958b;border-color:#8f958b;color:#fff}
.wc.flip{animation:flip .45s ease both}
@keyframes flip{0%{transform:rotateX(0)}50%{transform:rotateX(90deg)}100%{transform:rotateX(0)}}
.kb{display:grid;gap:6px;width:min(100%,500px)}
.kr{display:flex;gap:5px;justify-content:center}
.kr button{flex:1;max-width:44px;height:54px;border:0;border-radius:8px;background:#dfe2d8;font:700 15px/1 var(--body);text-transform:uppercase;cursor:pointer;padding:0}
.kr button.wide{max-width:68px;flex:1.5;font-size:11px;letter-spacing:-.02em}
.kr button.g{background:#4f8a4a;color:#fff}.kr button.y{background:#d8b43a;color:#fff}.kr button.x{background:#8f958b;color:#fff}
.toast{position:fixed;left:50%;top:90px;transform:translateX(-50%);background:var(--ink);color:#fff;padding:10px 16px;border-radius:12px;font-weight:600;z-index:60}
@@ body
<div class="ghead"><div><h1>Daily Word</h1><p>Guess the five-letter word in six tries. A new word every day at midnight (Las Vegas time).</p></div><span class="lbl" id="dayno"></span></div>
<div class="glay">
  <div class="stage" style="position:relative">
    <div class="wgrid" id="grid"></div>
    <div class="kb" id="kb"></div>
    <div id="after" class="row" hidden></div>
  </div>
  <div class="side">
    <div class="box"><h2>Your stats</h2><div class="stats" id="stats"></div></div>
    <div class="box" id="lb"></div>
  </div>
</div>
@@ js
const EPOCH=Date.UTC(2026,9,1);
const today=new Date().toLocaleDateString('en-CA',{timeZone:'America/Los_Angeles'});  // YYYY-MM-DD
const dayNo=Math.round((Date.parse(today+'T00:00:00Z')-EPOCH)/864e5);
const A=WORDS.answers;
let answer=A[((dayNo%A.length)+A.length)%A.length],practice=false;
let st=G.local.get('word:'+today,{guesses:[],done:false});
document.getElementById('dayno').textContent='#'+(dayNo+1);
let typed='';
const grid=document.getElementById('grid');
function score(guess,ans){const r=Array(5).fill('x'),a=ans.split(''),used=Array(5).fill(false);
  for(let i=0;i<5;i++)if(guess[i]===a[i]){r[i]='g';used[i]=true}
  for(let i=0;i<5;i++)if(r[i]!=='g'){const j=a.findIndex((c,k)=>!used[k]&&c===guess[i]);if(j>=0){r[i]='y';used[j]=true}}return r}
function draw(flipRow){
  grid.innerHTML=[...Array(6)].map((_,r)=>{const g=st.guesses[r];const s=g?score(g,answer):null;const w=g||(r===st.guesses.length&&!st.done?typed:'');
    return `<div class="wrow" data-r="${r}">${[...Array(5)].map((_,c)=>`<div class="wc ${s?s[c]+(r===flipRow?' flip':''):w[c]?'f':''}" style="${r===flipRow?`animation-delay:${c*.12}s`:''}">${w[c]||''}</div>`).join('')}</div>`}).join('');
  const kstate={};st.guesses.forEach(g=>score(g,answer).forEach((s,i)=>{const k=g[i],p=kstate[k];if(s==='g'||(s==='y'&&p!=='g')||(!p))kstate[k]=s}));
  document.getElementById('kb').innerHTML=['qwertyuiop','asdfghjkl','+zxcvbnm-'].map(r=>`<div class="kr">${[...r].map(k=>k==='+'?'<button class="wide" data-k="Enter">Enter</button>':k==='-'?'<button class="wide" data-k="Backspace" aria-label="Delete">⌫</button>':`<button data-k="${k}" class="${kstate[k]||''}">${k}</button>`).join('')}</div>`).join('');
  stats();
}
function toast(t){document.querySelectorAll('.toast').forEach(x=>x.remove());const d=document.createElement('div');d.className='toast';d.textContent=t;document.body.append(d);setTimeout(()=>d.remove(),1800)}
function shake(){const r=grid.querySelector(`[data-r="${st.guesses.length}"]`);r&&(r.classList.remove('shake'),void r.offsetWidth,r.classList.add('shake'))}
async function key(k){if(st.done)return;
  if(k==='Enter'){if(typed.length<5){toast('Not enough letters');return shake()}if(!WORDS.valid.has(typed)){toast('Not in word list');return shake()}
    st.guesses.push(typed);typed='';const won=st.guesses[st.guesses.length-1]===answer;if(won||st.guesses.length===6){st.done=true;st.won=won}
    if(!practice)G.local.set('word:'+today,st);draw(st.guesses.length-1);if(st.done)setTimeout(finish,800);return}
  if(k==='Backspace'){typed=typed.slice(0,-1);return draw()}
  if(/^[a-z]$/.test(k)&&typed.length<5){typed+=k;draw()}}
async function finish(){
  const n=st.guesses.length;
  if(!practice&&!st.recorded){const h=G.local.get('word:history',{});h[today]=st.won?n:0;G.local.set('word:history',h);st.recorded=true;G.local.set('word:'+today,st);stats()}
  const a=document.getElementById('after');a.hidden=false;
  a.innerHTML=`<span><b>${st.won?['Genius!','Magnificent!','Impressive!','Splendid!','Great!','Phew!'][n-1]:'The word was '+answer.toUpperCase()}</b> <span class="muted" id="wmsg"></span></span>${practice?'':'<button class="btn sm" id="share">Share</button>'}<button class="btn sm ghost" id="prac">Practice word</button>`;
  if(!practice&&st.won&&!st.saved){document.getElementById('wmsg').innerHTML=await G.submit('word',n,{day:today});st.saved=true;G.local.set('word:'+today,st)}
  if(document.getElementById('share'))document.getElementById('share').onclick=()=>{const t=`Daily Word #${dayNo+1} ${st.won?n:'X'}/6\n`+st.guesses.map(g=>score(g,answer).map(s=>({g:'🟩',y:'🟨',x:'⬜'})[s]).join('')).join('\n')+'\nkaleerson.com/edu/word';
    (navigator.share?navigator.share({text:t}).catch(()=>{}):navigator.clipboard.writeText(t).then(()=>toast('Copied to clipboard')))};
  document.getElementById('prac').onclick=()=>{practice=true;answer=A[Math.floor(Math.random()*A.length)];st={guesses:[],done:false};typed='';a.hidden=true;toast('Practice word. Not saved.');draw()};
}
function stats(){const h=G.local.get('word:history',{}),days=Object.keys(h).sort(),wins=days.filter(d=>h[d]>0);
  let streak=0;for(let d=new Date(today+'T12:00:00Z');;d.setUTCDate(d.getUTCDate()-1)){const k=d.toISOString().slice(0,10);if(h[k]>0)streak++;else if(k===today&&h[k]===undefined)continue;else break}
  document.getElementById('stats').innerHTML=`<div><b>${days.length}</b><span>Played</span></div><div><b>${days.length?Math.round(100*wins.length/days.length):0}%</b><span>Won</span></div><div><b>${streak}</b><span>Streak</span></div>`}
document.addEventListener('keydown',e=>{if(e.ctrlKey||e.metaKey||e.altKey||e.target.matches('input'))return;const k=e.key==='Enter'||e.key==='Backspace'?e.key:e.key.toLowerCase();if(k==='Enter'||k==='Backspace'||/^[a-z]$/.test(k)){e.preventDefault();key(k)}});
document.getElementById('kb').addEventListener('click',e=>{const b=e.target.closest('[data-k]');if(b)key(b.dataset.k)});
draw();if(st.done)finish();
G.boardBox(document.getElementById('lb'),'word');
